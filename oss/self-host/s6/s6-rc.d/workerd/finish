#!/command/with-contenv sh
# s6 finish script: workerd
#
# Called when workerd exits. Logs the exit status for debugging.
# Exit code 0 = normal shutdown, non-zero = unexpected crash.

exit_code=$1
signal=$2

if [ "$exit_code" -ne 0 ]; then
    echo "workerd exited with code ${exit_code} (signal: ${signal})" >&2
fi
