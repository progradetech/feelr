# Feelr Caddy Reverse Proxy
#
# Provides automatic Let's Encrypt TLS for the Feelr self-hosted stack.
# Activated via: docker compose --profile tls up
#
# Set FEELR_DOMAIN in your .env to your public domain name.
# Caddy automatically obtains and renews TLS certificates via ACME.
#
# For local development without a real domain, use:
#   FEELR_DOMAIN=localhost

{$FEELR_DOMAIN:localhost} {
	reverse_proxy feelr:8080
}
